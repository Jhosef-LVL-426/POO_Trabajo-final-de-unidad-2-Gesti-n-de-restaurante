    <table id="TAB5" populated="true" UUID="77cdf7b3-57bb-4253-8c0c-add907138878" name="Detalle del pedido" objectType="TABLE" physicalName="detalle_pedido">
      <remarks>Una fila representa un plato dentro de un pedido. Guarda el nombre y el precio de ese momento para conservar el detalle histórico.</remarks>
