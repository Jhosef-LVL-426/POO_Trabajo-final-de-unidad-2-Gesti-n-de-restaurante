    <table id="TAB4" populated="true" UUID="f95c54ed-0218-4725-8176-c3285a70a323" name="Pedidos" objectType="TABLE" physicalName="pedidos">
      <remarks>Un pedido agrupa uno o más platos. El total es la suma de los subtotales de sus líneas. Las asociaciones del diagrama se resuelven en la aplicación y no están declaradas como claves foráneas en el script H2.</remarks>
      <folder id="FOLTAB41" populated="true" name="Columns" physicalName="Columns" type="1">
        <column id="COL13" populated="true" UUID="c71e19db-29a1-45c8-a1ee-c1a4b89cb3c3" autoIncrement="true" autoIncrementSequenceName="pedidos_id_seq" defaultValue="" name="ID" nullable="0" physicalName="id" precision="19" referenceCount="2" scale="0" sourceDataTypeName="BIGINT" type="-5" primaryKeySeq="0">
          <remarks>Identificador único que H2 genera para cada registro.</remarks>
        </column>
        <column id="COL14" populated="true" UUID="0fd22053-7de8-4f48-8230-9df14753e28c" autoIncrement="false" autoIncrementSequenceName="pedidos_fecha_seq" defaultValue="CURRENT_TIMESTAMP" name="Fecha y hora" nullable="1" physicalName="fecha" precision="0" referenceCount="1" scale="0" sourceDataTypeName="TIMESTAMP" type="93">
          <remarks>Momento en que se registra el pedido.</remarks>
        </column>
        <column id="COL15" populated="true" UUID="8b4cd9a8-2b46-4660-b3d6-a71abcc7a4c6" autoIncrement="false" autoIncrementSequenceName="pedidos_mesa_id_seq" defaultValue="" name="Mesa asignada" nullable="1" physicalName="mesa_id" precision="19" referenceCount="2" scale="0" sourceDataTypeName="BIGINT" type="-5">
          <remarks>Referencia a mesas.id. Puede quedar vacía para registrar un pedido sin mesa.</remarks>
        </column>
        <column id="COL16" populated="true" UUID="d7bd042d-9bc4-4acf-abce-c63cdd1857e6" autoIncrement="false" autoIncrementSequenceName="pedidos_cliente_seq" defaultValue="" name="Nombre de atención" nullable="1" physicalName="cliente" precision="100" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
          <remarks>Texto guardado al tomar el pedido. Si se omite, se registra Cliente general.</remarks>
        </column>
        <column id="COL17" populated="true" UUID="8958150c-4b9e-4a1f-a13e-dfc4028fe54c" autoIncrement="false" autoIncrementSequenceName="pedidos_total_seq" defaultValue="" name="Total del pedido" nullable="0" physicalName="total" precision="10" referenceCount="1" scale="2" sourceDataTypeName="DECIMAL" type="3">
          <remarks>Suma de los subtotales del detalle, en soles.</remarks>
        </column>
        <column id="COL18" populated="true" UUID="14726804-2664-4da7-bb36-0ea87c2510ac" autoIncrement="false" autoIncrementSequenceName="pedidos_estado_seq" defaultValue="'PENDIENTE'" name="Estado del pedido" nullable="1" physicalName="estado" precision="20" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
          <remarks>PENDIENTE, EN PREPARACION, LISTO, ENTREGADO o CANCELADO.</remarks>
        </column>
      </folder>
