    <table id="TAB1" populated="true" UUID="66615f42-ceca-42b5-b524-c6427ea00749" name="Platos de la carta" objectType="TABLE" physicalName="platos">
      <remarks>Cada fila es un plato que el restaurante ofrece. Su precio actual se copia al detalle cuando se registra un pedido.</remarks>
      <folder id="FOLTAB11" populated="true" name="Columns" physicalName="Columns" type="1">
        <column id="COL1" populated="true" UUID="bc92257d-d9d6-465b-bed8-19c1db751e07" autoIncrement="true" autoIncrementSequenceName="platos_id_seq" defaultValue="" name="ID" nullable="0" physicalName="id" precision="19" referenceCount="2" scale="0" sourceDataTypeName="BIGINT" type="-5" primaryKeySeq="0">
          <remarks>Identificador único que H2 genera para cada registro.</remarks>
        </column>
        <column id="COL2" populated="true" UUID="2a58e450-0d11-4cc1-b983-f917eb65c13f" autoIncrement="false" autoIncrementSequenceName="platos_nombre_seq" defaultValue="" name="Nombre del plato" nullable="0" physicalName="nombre" precision="90" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
          <remarks>Nombre que aparece en la carta. El buscador admite fragmentos con o sin tildes.</remarks>
        </column>
        <column id="COL3" populated="true" UUID="26c4c459-e2de-48bb-b1d6-ab25e6d38edc" autoIncrement="false" autoIncrementSequenceName="platos_categoria_seq" defaultValue="" name="Categoría" nullable="0" physicalName="categoria" precision="40" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
          <remarks>Agrupa los platos en la carta, por ejemplo, postres.</remarks>
        </column>
        <column id="COL4" populated="true" UUID="2bf7d62d-00ba-4e12-a824-c7e7156083c6" autoIncrement="false" autoIncrementSequenceName="platos_precio_seq" defaultValue="" name="Precio de carta" nullable="0" physicalName="precio" precision="10" referenceCount="1" scale="2" sourceDataTypeName="DECIMAL" type="3">
          <remarks>Importe actual de una porción, en soles.</remarks>
        </column>
        <column id="COL5" populated="true" UUID="c07d704f-9eb4-4cbc-b717-675fe45a6ac1" autoIncrement="false" autoIncrementSequenceName="platos_disponible_seq" defaultValue="TRUE" name="Disponible para pedir" nullable="1" physicalName="disponible" precision="1" referenceCount="1" scale="0" sourceDataTypeName="BOOLEAN" type="16">
          <remarks>Solo los platos disponibles aparecen al tomar un pedido.</remarks>
        </column>
      </folder>
