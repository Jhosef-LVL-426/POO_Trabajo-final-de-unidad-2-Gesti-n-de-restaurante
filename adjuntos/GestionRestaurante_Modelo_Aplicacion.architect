        <column id="COL30" populated="true" UUID="fc4a42f1-c854-4208-af11-ac62768f8a88" autoIncrement="false" autoIncrementSequenceName="reservas_hora_seq" defaultValue="" name="Hora de llegada" nullable="0" physicalName="hora" precision="10" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
