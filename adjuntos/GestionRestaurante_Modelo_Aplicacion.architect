    <table id="TAB6" populated="true" UUID="7153985d-2e1e-4301-8f65-e95aeaa65ba6" name="Reservas" objectType="TABLE" physicalName="reservas">
      <remarks>Una reserva registra quién viene, cuándo y cuántas personas asistirán. El formulario no asigna una mesa específica.</remarks>
