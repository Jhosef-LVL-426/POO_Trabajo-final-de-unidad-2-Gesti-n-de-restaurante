    <table id="TAB7" populated="true" UUID="8ff20c03-7689-4631-8cef-44dfde5ec40e" name="Inventario de insumos" objectType="TABLE" physicalName="insumos">
      <remarks>Cada insumo tiene una existencia actual y un mínimo. La pantalla señala REABASTECER cuando la existencia es igual o inferior al mínimo.</remarks>
      <folder id="FOLTAB71" populated="true" name="Columns" physicalName="Columns" type="1">
        <column id="COL33" populated="true" UUID="9880a7a6-df53-4fb1-8e73-697e7899a94d" autoIncrement="true" autoIncrementSequenceName="insumos_id_seq" defaultValue="" name="ID" nullable="0" physicalName="id" precision="19" referenceCount="2" scale="0" sourceDataTypeName="BIGINT" type="-5" primaryKeySeq="0">
          <remarks>Identificador único que H2 genera para cada registro.</remarks>
        </column>
        <column id="COL34" populated="true" UUID="9cd526b5-8025-450d-8f03-d91642fbaae7" autoIncrement="false" autoIncrementSequenceName="insumos_nombre_seq" defaultValue="" name="Nombre del insumo" nullable="0" physicalName="nombre" precision="90" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
          <remarks>Producto que se controla, por ejemplo, harina.</remarks>
        </column>
        <column id="COL35" populated="true" UUID="8998127a-4b17-449b-8f51-77313de936b8" autoIncrement="false" autoIncrementSequenceName="insumos_unidad_seq" defaultValue="" name="Unidad de medida" nullable="0" physicalName="unidad" precision="20" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
