          <remarks>Identificador del plato seleccionado al tomar el pedido.</remarks>
        </column>
        <column id="COL22" populated="true" UUID="1a682c8d-0821-4993-8eb8-4b4b9d7794c4" autoIncrement="false" autoIncrementSequenceName="detalle_pedido_plato_seq" defaultValue="" name="Nombre al pedir" nullable="0" physicalName="plato" precision="90" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
          <remarks>Copia del nombre del plato al registrar la venta.</remarks>
        </column>
        <column id="COL23" populated="true" UUID="2b4632d0-5532-405b-a06a-5e4bea38b5f8" autoIncrement="false" autoIncrementSequenceName="detalle_pedido_cantidad_seq" defaultValue="" name="Porciones" nullable="0" physicalName="cantidad" precision="10" referenceCount="1" scale="0" sourceDataTypeName="INTEGER" type="4">
          <remarks>Cantidad entera mayor que cero.</remarks>
        </column>
        <column id="COL24" populated="true" UUID="497afc60-1ae6-4099-8464-55dd8a60f912" autoIncrement="false" autoIncrementSequenceName="detalle_pedido_precio_seq" defaultValue="" name="Precio al pedir" nullable="0" physicalName="precio" precision="10" referenceCount="1" scale="2" sourceDataTypeName="DECIMAL" type="3">
