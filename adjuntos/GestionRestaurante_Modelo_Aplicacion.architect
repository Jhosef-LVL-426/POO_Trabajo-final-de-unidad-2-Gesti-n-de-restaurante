          <remarks>Nombre que se usa para localizar la reserva.</remarks>
        </column>
        <column id="COL28" populated="true" UUID="452fdfc2-1e86-4578-bfdc-250473660cac" autoIncrement="false" autoIncrementSequenceName="reservas_telefono_seq" defaultValue="" name="Teléfono de contacto" nullable="1" physicalName="telefono" precision="20" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
          <remarks>Dato opcional para comunicarse con el titular.</remarks>
        </column>
        <column id="COL29" populated="true" UUID="7926a730-c985-401e-8daf-b4c5aca8e64b" autoIncrement="false" autoIncrementSequenceName="reservas_fecha_seq" defaultValue="" name="Día de la reserva" nullable="0" physicalName="fecha" precision="0" referenceCount="1" scale="0" sourceDataTypeName="DATE" type="91">
          <remarks>Fecha de la visita, hoy o un día posterior.</remarks>
