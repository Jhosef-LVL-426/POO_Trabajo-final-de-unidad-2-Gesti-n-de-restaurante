    <table id="TAB2" populated="true" UUID="9c979d5e-bcd0-456c-bb46-6c8498f70323" name="Mesas del salón" objectType="TABLE" physicalName="mesas">
      <remarks>Una mesa puede atender varios pedidos a lo largo del tiempo. Al registrar un pedido con mesa, la aplicación comprueba que esté libre y la ocupa.</remarks>
      <folder id="FOLTAB21" populated="true" name="Columns" physicalName="Columns" type="1">
        <column id="COL6" populated="true" UUID="79d1a314-58c1-4dca-b51e-a58882bf1e3c" autoIncrement="true" autoIncrementSequenceName="mesas_id_seq" defaultValue="" name="ID" nullable="0" physicalName="id" precision="19" referenceCount="2" scale="0" sourceDataTypeName="BIGINT" type="-5" primaryKeySeq="0">
          <remarks>Identificador único que H2 genera para cada registro.</remarks>
        </column>
        <column id="COL7" populated="true" UUID="26842147-3e6a-4bb4-9928-865ff770a03b" autoIncrement="false" autoIncrementSequenceName="mesas_numero_seq" defaultValue="" name="Número de mesa" nullable="0" physicalName="numero" precision="10" referenceCount="1" scale="0" sourceDataTypeName="INTEGER" type="4">
          <remarks>Número visible en el salón. Es único y puede diferir del identificador interno.</remarks>
        </column>
        <column id="COL8" populated="true" UUID="92e6105b-2059-4303-97e8-355ba60200eb" autoIncrement="false" autoIncrementSequenceName="mesas_capacidad_seq" defaultValue="" name="Capacidad en personas" nullable="0" physicalName="capacidad" precision="10" referenceCount="1" scale="0" sourceDataTypeName="INTEGER" type="4">
          <remarks>Número de personas para las que está preparada la mesa.</remarks>
        </column>
        <column id="COL9" populated="true" UUID="4788f219-9416-41f5-9cfc-bb5e984a270c" autoIncrement="false" autoIncrementSequenceName="mesas_estado_seq" defaultValue="'LIBRE'" name="Estado de la mesa" nullable="1" physicalName="estado" precision="20" referenceCount="1" scale="0" sourceDataTypeName="VARCHAR" type="12">
          <remarks>LIBRE u OCUPADA. La entrega o cancelación del pedido activo libera su mesa.</remarks>
        </column>
      </folder>
