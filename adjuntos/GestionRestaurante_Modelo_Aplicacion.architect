    <table id="TAB3" populated="true" UUID="600b82f4-b466-4839-87e2-92fae57cb1bb" name="Registro de clientes" objectType="TABLE" physicalName="clientes">
      <remarks>Directorio previsto en el esquema. Los pedidos y las reservas actuales guardan directamente el nombre de contacto.</remarks>
