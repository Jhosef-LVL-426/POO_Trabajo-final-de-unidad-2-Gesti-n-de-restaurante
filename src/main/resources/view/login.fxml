<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.restaurante.controller.LoginController"
      alignment="CENTER" spacing="12">
    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>
    <children>
        <Label text="Gestión de Restaurante" styleClass="titulo"/>
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <children>
                <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtUsuario" text="admin" onAction="#ingresar"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtPassword" onAction="#ingresar"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </children>
        </GridPane>
        <Button fx:id="btnIngresar" text="Ingresar" onAction="#ingresar"/>
        <Label text="Cuentas de demostración: admin y atencion"/>
    </children>
</VBox>
