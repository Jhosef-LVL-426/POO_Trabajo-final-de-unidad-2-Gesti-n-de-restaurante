<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.restaurante.controller.HistorialController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <children>
        <Label text="Historial de pedidos" styleClass="titulo"/>
        <Label text="Selecciona un pedido en la tabla. Puedes ver sus platos o cambiar su estado."/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <ComboBox fx:id="cbxEstado" promptText="Estado del pedido" prefWidth="180"/>
                <Button text="Actualizar estado" onAction="#actualizarEstado"/>
                <Button text="Ver detalle" onAction="#verDetalle"/>
                <Button text="Actualizar lista" onAction="#actualizarLista"/>
            </children>
        </HBox>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS"/>
    </children>
</VBox>
