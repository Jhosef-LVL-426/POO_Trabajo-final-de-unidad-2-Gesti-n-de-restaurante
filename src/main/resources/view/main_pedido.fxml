<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.restaurante.controller.PedidoController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <children>
        <Label text="Registrar pedido" styleClass="titulo"/>
        <Label text="1. Elige una mesa libre (o déjala vacía) y escribe el nombre del cliente."/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <ComboBox fx:id="cbxMesa" promptText="Mesa (opcional)" prefWidth="220"/>
                <TextField fx:id="txtCliente" promptText="Cliente (opcional)" prefWidth="180"/>
                <Button text="Actualizar mesas y platos" onAction="#actualizarOpciones"/>
            </children>
        </HBox>
        <Label text="2. Selecciona un plato, indica la cantidad y presiona Agregar plato."/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <ComboBox fx:id="cbxPlato" promptText="Plato disponible" prefWidth="290"/>
                <TextField fx:id="txtCantidad" promptText="Cantidad" prefWidth="90" text="1"/>
                <Button text="Agregar plato" onAction="#agregar"/>
                <Button text="Quitar seleccionado" onAction="#quitar"/>
            </children>
        </HBox>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label fx:id="lblTotal" text="Total: S/ 0.00"/>
                <Label text="3. Revisa el total y registra el pedido."/>
                <Button text="Registrar pedido" onAction="#registrar"/>
            </children>
        </HBox>
    </children>
</VBox>
