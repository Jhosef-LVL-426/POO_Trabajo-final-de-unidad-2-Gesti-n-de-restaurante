<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.restaurante.controller.ReservaController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <children>
        <Label text="Reservas" styleClass="titulo"/>
        <Label text="Escribe el cliente, elige la fecha y coloca la hora en formato 24 h (ejemplo: 19:30)."/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="txtCliente" promptText="Cliente" prefWidth="155"/>
                <TextField fx:id="txtTelefono" promptText="Teléfono (opcional)" prefWidth="155"/>
                <DatePicker fx:id="dpFecha" editable="false" prefWidth="140"/>
            </children>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="txtHora" promptText="Hora: 19:30" prefWidth="125"/>
                <TextField fx:id="txtPersonas" promptText="Personas" prefWidth="90" text="2"/>
                <Button text="Registrar reserva" onAction="#agregar"/>
                <Button text="Cancelar seleccionada" onAction="#cancelar"/>
                <Button text="Finalizar reserva" onAction="#finalizar"/>
                <Button text="Actualizar lista" onAction="#actualizarLista"/>
            </children>
        </HBox>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS"/>
    </children>
</VBox>
