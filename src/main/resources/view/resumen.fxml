<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.restaurante.controller.ResumenController" spacing="10">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <children>
                <Label text="Resumen general" styleClass="titulo"/>
                <Button text="Actualizar resumen" onAction="#actualizar"/>
            </children>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label text="Platos registrados:"/>
                <Label fx:id="lblPlatos"/>
                <Label text="Pedidos registrados:"/>
                <Label fx:id="lblPedidos"/>
            </children>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <children>
                <Label text="Mesas registradas:"/>
                <Label fx:id="lblMesas"/>
                <Label text="Reservas registradas:"/>
                <Label fx:id="lblReservas"/>
            </children>
        </HBox>
        <Label text="Últimos 8 pedidos (incluye los cancelados)"/>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS"/>
    </children>
</VBox>
